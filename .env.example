# Local development only. Replace the JWT secret before deploying.
APP_ENV=development
JWT_SECRET_KEY=mock-development-only-replace-me-with-a-random-secret-at-least-32-bytes
JWT_ISSUER=proteinmaxxer-service
JWT_AUDIENCE=proteinmaxxer-api
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
AUTH_DATABASE_PATH=./data/proteinmaxxer.sqlite3
AUTH_RATE_LIMIT=30
AUTH_RATE_WINDOW_SECONDS=60
# Expo web development. Set explicit HTTPS origins in production; native apps do not need CORS.
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# Comma-separated accepted OAuth client IDs (including Google iOS authorized presenters).
# Placeholder IDs leave social login disabled with HTTP 503. No verification bypass.
GOOGLE_CLIENT_IDS=mock-google-web-client-id.apps.googleusercontent.com,mock-google-ios-client-id.apps.googleusercontent.com
# Native iOS app bundle ID; add a Services ID here if also accepting web identity tokens.
APPLE_CLIENT_IDS=mock-com.yourcompany.proteinmaxxer

# Existing text generation routes use this key. Authentication does not require it.
OPENAI_API_KEY=
